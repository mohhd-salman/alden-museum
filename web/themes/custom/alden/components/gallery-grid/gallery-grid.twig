{#
  Available variables:
  - eyebrow: optional, e.g. "From the exhibition".
  - items: list of { ph_class, image }. The first item spans 2x2 (see
    .gal in gallery-grid.css) -- trimmed to however many real
    field_gallery items the exhibition actually has, not padded to match
    the mockup's 5. image is optional, falls back to ph_class.
#}
<section{{ attributes.addClass('sec') }} style="padding-top:0">
  <div class="wrap">
    {% if eyebrow %}<p class="eyebrow rv" style="margin-bottom:1.5rem">{{ eyebrow }}</p>{% endif %}
    <div class="gal rv">
      {% for item in items %}
        <div class="ph {{ item.ph_class }}{{ item.image ? ' has-image' : '' }}"><i>{% if item.image %}{{ item.image }}{% endif %}</i></div>
      {% endfor %}
    </div>
  </div>
</section>
